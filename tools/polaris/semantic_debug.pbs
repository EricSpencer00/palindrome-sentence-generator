#!/bin/bash -l
#PBS -N pal-semantic-debug
# Scheduler account configured by submitter.
#PBS -q debug
#PBS -l select=1:system=polaris
#PBS -l place=scatter
#PBS -l walltime=00:25:00
#PBS -l filesystems=home
#PBS -j oe
#PBS -o ${PALINDROME_REPO}/logs/

set -euo pipefail

REPO=${PALINDROME_REPO}
OUT=$REPO/runs/semantic_debug_$(date +%Y%m%d_%H%M%S)
mkdir -p "$OUT" "$REPO/logs"
cd "$REPO"
export PYTHONPATH="$REPO:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1

PY=/usr/bin/python3.11
NRANKS=32
PPN=32

echo "host=$(hostname) out=$OUT"
$PY -V
mpiexec -n $NRANKS --ppn $PPN --cpu-bind depth -d 1 \
  $PY tools/polaris/semantic_debug.py \
    --vocab 30000 --weights 0,0.25,0.5,1,2 \
    --candidate-limit 200 --beam 48 --per-parent 8 \
    --min-letters 80 --max-steps 240 --seeds-per-rank 4 --shards $NRANKS \
    --out-dir "$OUT"

$PY - "$OUT" <<'PY'
import glob, json, statistics, sys
summaries = [json.load(open(path)) for path in glob.glob(sys.argv[1] + '/summary_*.json')]
assert len(summaries) == 32, len(summaries)
rows = [row for summary in summaries for row in summary['rows']]
assert all(row['valid'] for row in rows if row['closed'])
arms = {}
for weight in summaries[0]['weights']:
    arm = [row for row in rows if row['weight'] == weight]
    closed = [row for row in arm if row['closed']]
    arms[str(weight)] = {
        'runs': len(arm), 'closed': len(closed),
        'closure_rate': len(closed) / len(arm),
        'distinct_openings': len({row['opening'] for row in closed}),
        'distinct_ratio': statistics.mean(row['distinct_ratio'] for row in closed) if closed else None,
        'attested_pair_rate': statistics.mean(row['attested_pair_rate'] for row in closed) if closed else None,
        'mean_order_gain': statistics.mean(row['mean_order_gain'] for row in closed) if closed else None,
    }
aggregate = {'ranks': len(summaries), 'arms': arms}
json.dump(aggregate, open(sys.argv[1] + '/aggregate.json', 'w'), indent=2)
print(json.dumps(aggregate, indent=2))
PY
