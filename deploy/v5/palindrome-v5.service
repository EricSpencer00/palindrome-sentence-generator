[Unit]
Description=palindrome v5 paragraph API
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/palindrome-v5
ExecStart=/home/ubuntu/palindrome-v5/.venv/bin/uvicorn server.v5:app --host 127.0.0.1 --port 8045
Restart=always
Nice=5

[Install]
WantedBy=multi-user.target
