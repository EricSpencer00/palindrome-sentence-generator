{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "grammaticality": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "item_id": {
            "pattern": "^P-[A-F0-9]{12}$",
            "type": "string"
          },
          "item_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "paraphrase": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "understandability": {
            "anyOf": [
              {
                "maximum": 5,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item_id",
          "item_sha256",
          "grammaticality",
          "understandability",
          "paraphrase"
        ],
        "type": "object"
      },
      "maxItems": 52,
      "minItems": 52,
      "type": "array"
    },
    "completed_count": {
      "maximum": 52,
      "minimum": 0,
      "type": "integer"
    },
    "current_index": {
      "maximum": 51,
      "minimum": 0,
      "type": "integer"
    },
    "exported_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "item_count": {
      "const": 52
    },
    "packet_id": {
      "const": "palindrome-v4-pilot-9229cdfdf761dace"
    },
    "paused": {
      "type": "boolean"
    },
    "review_scope": {
      "const": "one_author_first_person_pilot_exploratory_not_confirmatory"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_input_sha256": {
      "const": "9229cdfdf761dace9824686bd2f9ed285b30a12c798045995d6fa834e3130bf0"
    },
    "started": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "packet_id",
    "source_input_sha256",
    "exported_at_utc",
    "review_scope",
    "item_count",
    "completed_count",
    "current_index",
    "started",
    "paused",
    "answers"
  ],
  "title": "Palindrome v4 first-person pilot answer export",
  "type": "object"
}
